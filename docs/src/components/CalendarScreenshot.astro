---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  cropTop?: number;
  cropHeight?: number;
}
const { src, alt, caption, cropTop = 0, cropHeight = src.height } = Astro.props;
---

<figure class="calendar-screenshot">
  <a style={`aspect-ratio: ${src.width} / ${cropHeight}; --crop-top: ${-cropTop / src.width * 100}%;`} href={src.src} aria-label={`View full screenshot: ${alt}`}>
    <Image src={src} alt={alt} width={720} loading="lazy" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .calendar-screenshot { width: 100%; max-width: 25rem; margin: 1.5rem auto 2rem; }
  a { display: block; overflow: hidden; border: 1px solid var(--sd-color-line); border-radius: var(--sd-radius-card); background: #f7f5ec; }
  a :global(img) { display: block; width: 100%; height: auto; margin: var(--crop-top) 0 0; }
  figcaption { margin-top: .6rem; font-size: var(--sl-text-xs); line-height: 1.6; color: var(--sd-color-muted); }
  a:focus-visible { outline: 3px solid var(--sd-color-link); outline-offset: 4px; }
</style>
