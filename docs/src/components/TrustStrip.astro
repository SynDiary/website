---
/* Compact trust + support line. Uses the marketing site's verified
   "your data, your rules" language (not an unverified "local-first" claim). */
---

<div class="sd-trust" data-pagefind-ignore>
  <p class="sd-trust-line">
    <strong>Your data, your rules.</strong>
    <a href="/privacy-security-permissions/">Privacy &amp; security →</a>
  </p>
  <p class="sd-trust-support">Still need help? <a href="https://www.syndiary.com/#contact" target="_blank" rel="noopener noreferrer">Contact the team →</a></p>
</div>

<style>
  .sd-trust {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    padding-block: 2.75rem 3.25rem;
  }
  .sd-trust-line {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.9rem;
    margin: 0;
  }
  .sd-trust-line strong {
    color: var(--sd-color-text);
  }
  .sd-trust-support {
    margin: 0;
    color: var(--sd-color-muted); /* marketing secondary — this strip sits on white */
  }
  .sd-trust a {
    color: var(--sd-color-link);
    font-weight: 600;
    /* Persistent underline so inline links aren't distinguished by colour alone
       (WCAG 1.4.1) — the link vs. surrounding text is below 3:1 on the warm text grey. */
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .sd-trust a:hover {
    text-decoration-thickness: 2px;
  }
</style>
