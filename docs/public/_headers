# Cloudflare Pages headers for docs.syndiary.com.
# Copied verbatim into dist/ at build time. Do NOT copy the marketing site's
# www/_headers here — the two sites have different needs.

# Hashed, content-addressed build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Do NOT immutable-cache HTML or /pagefind/* — they change every build.

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  X-Frame-Options: DENY
# TODO(hardening): add a Content-Security-Policy (start report-only) once search
# and any embedded media are validated.
